# =============================================================================
#  .env.example - Bitácora GRM
#  Copia este archivo a `.env` y ajusta los valores para desarrollo local.
#  En Railway, estas variables se configuran en el dashboard (no subir .env).
# =============================================================================

# === Aplicación ===
APP_NAME="Bitácora GRM"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-me-please-in-production-123456789"

# === Modo de base de datos ===
# true  -> usa SQLite (./bitacora_grm.db), ideal para demo/desarrollo
# false -> usa PostgreSQL (configurado por DATABASE_URL o variables POSTGRES_*)
USE_SQLITE=true

# === Base de datos (PostgreSQL) ===
# Railway provee automáticamente DATABASE_URL con formato
#   postgresql+psycopg2://user:pass@host:port/db
# En desarrollo local puedes omitirlo y usar las variables sueltas.
POSTGRES_USER=grm
POSTGRES_PASSWORD=grm_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitacora_grm

# DATABASE_URL tiene prioridad si está definido.
#   PostgreSQL: postgresql+psycopg2://user:pass@host:5432/db
#   SQLite:     sqlite:///./bitacora_grm.db
# Ejemplo Railway: postgresql+psycopg2://postgres:xxxx@containers-us-west-1.railway.app:7890/railway
DATABASE_URL=

# === Redis / Celery ===
# Railway provee REDIS_URL automáticamente al adjuntar el plugin Redis.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === JWT ===
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# === CORS ===
# Lista JSON válida. En producción limita a tu dominio.
CORS_ORIGINS=["*"]

# === Inicialización automática ===
# true -> corre `python -m app.db.init_db` al arrancar (útil para demo)
AUTO_INIT_DB=false

# === Puerto (Railway expone $PORT automáticamente) ===
# PORT=8000

# === Concurrencia de gunicorn ===
# WEB_CONCURRENCY=2
# WEB_THREADS=4
# LOG_LEVEL=info
