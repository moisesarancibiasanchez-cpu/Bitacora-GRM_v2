# =============================================================================
#  .env.example — ITSM/Kanban MVP (plantilla)
#  Copia este archivo a .env y completa los valores.
# =============================================================================

# === Aplicación ===
APP_NAME="ITSM Kanban MVP"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-me-to-a-random-32-bytes-secret"
PUBLIC_BASE_URL="http://localhost:8000"

# === Base de datos PostgreSQL ===
# Formato: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg2://grm:grm@localhost:5432/itsm_kanban"

# === Redis (broker + result backend para Celery) ===
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# === JWT ===
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=480

# === Bootstrap admin (solo se usa al inicializar la BD vacía) ===
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="change-me-now"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
