# === Aplicación ===
APP_NAME="Bitácora GRM"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-me-please-in-production-123456789"

# === Base de datos (producción) ===
POSTGRES_USER=grm
POSTGRES_PASSWORD=grm_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitacora_grm
# DATABASE_URL tiene prioridad si está definido.
# Ejemplos:
#   PostgreSQL: postgresql+psycopg2://user:pass@host:5432/db
#   SQLite:     sqlite:///./bitacora_grm.db
DATABASE_URL=postgresql+psycopg2://grm:grm_secure_pass@localhost:5432/bitacora_grm

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === JWT ===
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# === CORS ===
CORS_ORIGINS=["*"]
