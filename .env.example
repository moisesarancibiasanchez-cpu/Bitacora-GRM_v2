# =============================================================================
#  .env.example - Bitácora GRM
#  Copia este archivo a `.env` y ajusta los valores para desarrollo local.
#  En Railway, estas variables se configuran en el dashboard (no subir .env).
# =============================================================================

# === Aplicación ===
APP_NAME="Bitácora GRM"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-me-please-in-production-123456789"
APP_TIMEZONE=America/Santiago
ROLES_DISPONIBLES=["administrador", "agente_senior", "agente", "solicitante", "observador"]

# === Seguridad HTTP ===
# En producción se recomienda EXPOSE_API_DOCS=false para no publicar
# /docs, /redoc y /openapi.json. El valor siguiente conserva el default
# seguro de app/core/config.py; una cadena vacía desactiva la cabecera CSP.
EXPOSE_API_DOCS=true
SECURITY_CSP="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

# === Modo de base de datos ===
# true  -> usa SQLite (./bitacora_grm.db), ideal para demo/desarrollo
# false -> usa PostgreSQL (configurado por DATABASE_URL o variables POSTGRES_*)
USE_SQLITE=true

# === Base de datos (PostgreSQL) ===
# Railway provee automáticamente DATABASE_URL con formato
#   postgresql+psycopg2://user:pass@host:port/db
# En desarrollo local puedes omitirlo y usar las variables sueltas.
POSTGRES_USER=grm
POSTGRES_PASSWORD=grm_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitacora_grm

# DATABASE_URL tiene prioridad si está definido.
#   PostgreSQL: postgresql+psycopg2://user:pass@host:5432/db
#   SQLite:     sqlite:///./bitacora_grm.db
# Ejemplo Railway: postgresql+psycopg2://postgres:xxxx@containers-us-west-1.railway.app:7890/railway
DATABASE_URL=

# === Redis / Celery ===
# Railway provee REDIS_URL automáticamente al adjuntar el plugin Redis.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === JWT ===
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# === CORS ===
# Lista JSON válida. En producción limita a tu dominio.
# El comodín "*" NO se permite en desarrollo (DEBUG=true): la app es
# server-rendered y same-origin, así que hay que indicar el origen real.
# En producción (DEBUG=false) "*" se degrada a advertencia (el middleware
# desactiva allow_credentials ante el comodín), pero lo correcto es listar
# aquí los orígenes reales, p. ej. el dominio público de Railway.
CORS_ORIGINS=["http://localhost:8000"]

# === SMTP (envío de correos) ===
# Si SMTP_HOST y SMTP_FROM están definidos, los correos se envían vía SMTP.
# Si NO están definidos, los correos se persisten en tmp/app.email.log (modo dev/demo).
#
#   SMTP_HOST      - servidor SMTP (ej: smtp.resend.com, smtp.gmail.com)
#   SMTP_PORT      - puerto (587 = STARTTLS, 465 = SMTPS/SSL implícito)
#   SMTP_USER      - usuario para autenticación (en Resend: "resend")
#   SMTP_PASSWORD  - API key / contraseña (en Resend: empieza con "re_")
#   SMTP_FROM      - dirección remitente DEBE tener el dominio verificado
#   SMTP_USE_TLS   - true para STARTTLS (usar con puerto 587)
#   SMTP_USE_SSL   - true para SMTPS / TLS implícito (usar con puerto 465).
#                    Si se deja vacío, se autodetecta por puerto.
#
# ⚠️  IMPORTANTE: Resend exige que el dominio de SMTP_FROM esté verificado
#     en su dashboard (https://resend.com/domains). Si usas un subdominio
#     propio (ej: grmv2.tu-empresa.cl), agrega los registros DKIM/SPF que
#     Resend te entrega. NO se puede usar *.up.railway.app ni *.onrender.com
#     como remitente (esos dominios no son tuyos).
#
# === EJEMPLO RESEND (Railway) ===
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_TU_API_KEY_DE_RESEND
# SMTP_FROM=no-reply@tu-dominio-verificado.cl
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="no-reply@grmv2.tu-dominio.cl"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# === Variables leídas directamente por módulos (fuera de Settings) ===
# RESEND_API_KEY: habilita el envío HTTPS directo a Resend.
RESEND_API_KEY=
# SMTP_TEST_TO: destinatario usado únicamente por scripts/test_smtp.py.
SMTP_TEST_TO=
# ALLOW_XUSER_HEADER: habilita el header de identidad para integración interna.
ALLOW_XUSER_HEADER=false
# SEED_DEMO_USERS: crea usuarios de demostración durante init_db.
SEED_DEMO_USERS=false
# UPLOAD_DIR: raíz de archivos subidos; el código resuelve rutas relativas al proyecto.
UPLOAD_DIR=uploads

# === Solo pruebas/herramientas (mantener comentadas en producción) ===
# TEST_DATABASE_URL=
# BITACORA_ADMIN_USER=
# BITACORA_ADMIN_PASSWORD=
# BITACORA_APP_URL=
# MY_IP=
# NEW_ADMIN_PASSWORD=
# PUBLIC_BASE_URL_BACKUP=
# PYTHONIOENCODING=utf-8
# RAILWAY_DATABASE_URL=
# RAILWAY_PROJECT_ID=
# RAILWAY_TOKEN_FILE=
# TEMP=
# UAT_EXCEL_PATH=
# BEDROCK_PROJECT=
# CHROMIUM_PATH=
# PLAYWRIGHT_BROWSERS_PATH=

# === Variables inyectadas por Railway (no definir manualmente) ===
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=

# === Dev Inbox (entornos de prueba multi-destinatario) ===
# Cuando NO hay SMTP configurado, la aplicación captura todos los correos
# que intenta enviar y los expone en una bandeja consultable por HTTP:
#   GET    /dev/inbox         → vista HTML con los últimos correos
#   GET    /dev/inbox.json    → lista JSON (para integraciones / tests)
#   GET    /dev/inbox/{id}    → detalle de un correo (HTML + texto plano)
#   DELETE /dev/inbox         → limpia la bandeja
#   GET    /dev/inbox/status  → diagnóstico (backend activo, conteo, etc.)
#
# Es la opción recomendada para entornos de prueba donde necesitas enviar
# correos a MÚLTIPLES destinatarios de distintas empresas sin tener que
# verificar un dominio propio en servicios como Resend/SendGrid/Mailgun.
#
#   DEV_INBOX_ENABLED         - true/false (vacío = auto: se activa
#                                cuando no hay SMTP_HOST configurado).
#   DEV_INBOX_MAX             - máximo de correos conservados (FIFO).
#                                Default: 200.
#   DEV_INBOX_REQUIRE_AUTH    - true para exigir JWT válido al consultar
#                                la bandeja (recomendable si la app está
#                                expuesta a internet).
#
# Almacenamiento: usa Redis si REDIS_URL está disponible (ideal para
# Railway). Si no, cae a tmp/dev_inbox.jsonl (filesystem).
DEV_INBOX_ENABLED=
DEV_INBOX_MAX=200
DEV_INBOX_REQUIRE_AUTH=false

# URL pública del sistema (se incluye en los correos de bienvenida/credenciales).
# En producción, reemplazar por la URL oficial (ej: https://grmv2.tu-dominio.cl).
PUBLIC_BASE_URL=http://localhost:8000

# === Inicialización automática ===
# true -> corre `python -m app.db.init_db` al arrancar (útil para demo)
AUTO_INIT_DB=false

# === Variables consumidas por start.sh antes de cargar Python ===
# start.sh NO carga este archivo .env. Estas variables deben exportarse en el
# shell o configurarse como variables del entorno en Railway.
# SEED_DATA=false
# SECRET_KEY_FILE=/data/secrets/secret_key
# PROC_TYPE=web
# APP_ROLE=web
# CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# === Puerto (Railway expone $PORT automáticamente) ===
# PORT=8000

# === Concurrencia de gunicorn ===
# WEB_CONCURRENCY=2
# WEB_THREADS=4
# LOG_LEVEL=info
# BIND=0.0.0.0:$PORT
FORWARDED_ALLOW_IPS=*

# === Sistema de Backups de Base de Datos ===
# Directorio donde se almacenan los backups (.sql.gz para PG, .db.gz para SQLite).
# En Railway el filesystem es efímero: se recomienda montar un volumen o usar
# el endpoint /api/v1/butler/backup/download para descargar y resguardar externamente.
BACKUP_DIR=backups
# Política de retención: cantidad de días que se conservan los archivos antes
# de ser purgados automáticamente por la tarea diaria.
BACKUP_RETENTION_DAYS=30
# Hora del backup automático diario (formato 24h). Por defecto 00:00.
BACKUP_DAILY_HOUR=0
BACKUP_DAILY_MINUTE=0
# Tamaño máximo permitido por archivo (en MB) como protección anti-OOM.
BACKUP_MAX_SIZE_MB=2048

# === Reporte Diario de Entregas ===
# Hora UTC en la que Beat dispara la tarea ``generar_reporte_diario``.
# Por defecto 18:00 UTC. En Chile continental eso corresponde a las 15:00
# en horario de invierno y 14:00 en horario de verano.
REPORTE_ENTREGAS_HOUR=18
REPORTE_ENTREGAS_MINUTE=0
# Si se define en False, la tarea programada registra entregas pero NO
# envía el correo (sigue funcionando como histórico / auditoría).
REPORTE_ENTREGAS_HABILITADO=true
