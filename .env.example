# =============================================================================
#  .env.example - Bitácora GRM
#  Copia este archivo a `.env` y ajusta los valores para desarrollo local.
#  En Railway, estas variables se configuran en el dashboard (no subir .env).
# =============================================================================

# === Aplicación ===
APP_NAME="Bitácora GRM"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-me-please-in-production-123456789"

# === Modo de base de datos ===
# true  -> usa SQLite (./bitacora_grm.db), ideal para demo/desarrollo
# false -> usa PostgreSQL (configurado por DATABASE_URL o variables POSTGRES_*)
USE_SQLITE=true

# === Base de datos (PostgreSQL) ===
# Railway provee automáticamente DATABASE_URL con formato
#   postgresql+psycopg2://user:pass@host:port/db
# En desarrollo local puedes omitirlo y usar las variables sueltas.
POSTGRES_USER=grm
POSTGRES_PASSWORD=grm_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitacora_grm

# DATABASE_URL tiene prioridad si está definido.
#   PostgreSQL: postgresql+psycopg2://user:pass@host:5432/db
#   SQLite:     sqlite:///./bitacora_grm.db
# Ejemplo Railway: postgresql+psycopg2://postgres:xxxx@containers-us-west-1.railway.app:7890/railway
DATABASE_URL=

# === Redis / Celery ===
# Railway provee REDIS_URL automáticamente al adjuntar el plugin Redis.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === JWT ===
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# === CORS ===
# Lista JSON válida. En producción limita a tu dominio.
CORS_ORIGINS=["*"]

# === SMTP (envío de correos) ===
# Cadena de transportes en orden de preferencia:
#   1) RESEND_API_KEY  → HTTP API de Resend (HTTPS, puerto 443, recomendado
#                        en PaaS como Railway/Heroku/Render donde los
#                        puertos SMTP 25/465/587 suelen estar bloqueados).
#   2) SMTP_HOST       → SMTP clásico (servidores propios, Gmail, etc.).
#   3) (ninguno)       → fallback: log local + Dev Inbox (/dev/inbox).
#
# Para activar Resend (RECOMENDADO EN RAILWAY):
#   - Crea una API Key en https://resend.com/api-keys
#   - Verifica tu dominio (ej: correo.centropromos.cl) en la sección Domains
#   - SMTP_FROM debe usar una dirección del dominio verificado
RESEND_API_KEY=

#   SMTP_HOST     - servidor SMTP (ej: smtp.gmail.com, smtp.resend.com)
#   SMTP_PORT     - puerto (587 = STARTTLS, 465 = SMTPS). NOTA: muchos PaaS
#                   bloquean AMBOS puertos. Si SMTP_USE_SSL=true y port=465
#                   o port=587 con STARTTLS falla con timeout, usa RESEND_API_KEY.
#   SMTP_USER     - usuario para autenticación (opcional)
#   SMTP_PASSWORD - contraseña / app password (opcional)
#   SMTP_FROM     - dirección remitente (REQUERIDO para activar SMTP/API)
#   SMTP_USE_TLS  - true para STARTTLS sobre puerto 587 (recomendado)
#   SMTP_USE_SSL  - true para SMTPS sobre puerto 465 (alternativa)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="no-reply@correo.tu-dominio.cl"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# URL pública del sistema (se incluye en los correos de bienvenida/credenciales).
# En producción, reemplazar por la URL oficial (ej: https://grmv2.tu-dominio.cl).
PUBLIC_BASE_URL=http://localhost:8000

# === Inicialización automática ===
# true -> corre `python -m app.db.init_db` al arrancar (útil para demo)
AUTO_INIT_DB=false

# === Puerto (Railway expone $PORT automáticamente) ===
# PORT=8000

# === Concurrencia de gunicorn ===
# WEB_CONCURRENCY=2
# WEB_THREADS=4
# LOG_LEVEL=info
